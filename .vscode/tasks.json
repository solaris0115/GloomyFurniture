{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Gloomylynx (1.6 Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/build-gloomylynx.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "Build Gloomylynx (1.6 Release)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/build-gloomylynx.ps1",
        "-Configuration",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      }
    }
  ]
}
