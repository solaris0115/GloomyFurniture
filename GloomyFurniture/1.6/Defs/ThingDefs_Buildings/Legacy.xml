<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- GloomyFurniture StreetLamp White legacy: 세이브 호환용. 신규 건설·메뉴·연구 잠금(neverBuildable + designationCategory null). -->
	<ThingDef ParentName="BuildingBase">
		<defName>GL_Street_Lamp_L_White</defName>
		<label>Street lamp(white)</label>
		<description>It's a street lamp.</description>
		<category>Building</category>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/Furniture/RGK_Street_LampE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
			<drawSize>(4,4)</drawSize>
			<damageData>
				<rect>(0.35,0.35,0.3,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Furniture/GL_Street_Lamp_Icon</uiIconPath>
		<uiIconScale>1.25</uiIconScale>
		<rotatable>false</rotatable>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>8</pathCost>
		<constructEffect>ConstructMetal</constructEffect>
		<tickerType>Normal</tickerType>
		<fillPercent>0.2</fillPercent>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>250</WorkToBuild>
			<Flammability>0</Flammability>
			<Beauty>8</Beauty>
		</statBases>
		<selectable>true</selectable>
		<costList>
			<WoodLog>15</WoodLog>
			<Steel>25</Steel>
		</costList>
		<building>
			<neverBuildable>true</neverBuildable>
		</building>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<placeWorkers>
			<li>PlaceWorker_GlowRadius</li>
		</placeWorkers>
		<comps>
			<li Class="CompProperties_Flickable">
				<commandTexture>UI/Commands/OnOff</commandTexture>
			</li>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>2</fuelConsumptionRate>
				<fuelCapacity>50.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>WoodLog</li>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
				<initialFuelPercent>1</initialFuelPercent>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>16</glowRadius>
				<glowColor>(255,255,255,0)</glowColor>
				<colorPickerEnabled>true</colorPickerEnabled>
				<darklightToggle>true</darklightToggle>
			</li>
		</comps>
		<designationCategory IsNull="True" />
		<destroyable>true</destroyable>
		<tradeability>None</tradeability>
	</ThingDef>

